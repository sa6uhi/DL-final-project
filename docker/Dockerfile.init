# Data-init image: minimal CPU stack for raw-data download + preparation.
# Only the dependencies of src.data.download_data / src.data.prepare_data
# (pandas + pyarrow + scikit-learn + pyyaml + numpy) - no torch, no serving.

FROM python:3.14-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip --quiet \
    && /opt/venv/bin/pip install --quiet \
        "numpy==2.5.2" \
        "pandas==3.0.5" \
        "pyarrow==25.0.1" \
        "scikit-learn==1.9.0" \
        "PyYAML==6.0.3"

FROM python:3.14-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN useradd --system --uid 10001 --create-home appuser \
    && mkdir -p /app/data /app/logs \
    && chown -R appuser:appuser /app

COPY --from=builder --chown=appuser:appuser /opt/venv /opt/venv
COPY --chown=appuser:appuser config/ ./config/
COPY --chown=appuser:appuser src/data/ ./src/data/
COPY --chown=appuser:appuser src/utils/ ./src/utils/
COPY --chown=appuser:appuser src/__init__.py ./src/__init__.py

USER appuser

VOLUME ["/app/data", "/app/logs"]

CMD ["bash", "-c", "if [ -f /app/data/processed/test.parquet ]; then echo 'Processed data present, skipping ingestion.'; else python -m src.data.download_data && python -m src.data.prepare_data; fi"]
